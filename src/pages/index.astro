---
const categories = [
  'Dünya',
  'Ekonomi',
  'Bilim',
  'Tarih',
  'Sanat',
  'Seyahat',
  'Hayvanlar',
  'Spor',
];

const latestNews = [
  {
    title: 'Dünyadan öne çıkan gelişmeler ve gündemin önemli başlıkları',
    category: 'Dünya',
    time: '2 saat önce',
  },
  {
    title: 'Ekonomide günün dikkat çeken verileri ve gelişmeleri',
    category: 'Ekonomi',
    time: '3 saat önce',
  },
  {
    title: 'Bilim dünyasında yeni araştırmalar ve keşifler',
    category: 'Bilim',
    time: '4 saat önce',
  },
  {
    title: 'Tarihten bugüne uzanan dikkat çekici bilgiler',
    category: 'Tarih',
    time: '5 saat önce',
  },
  {
    title: 'Sanat dünyasından güncel gelişmeler ve kültür haberleri',
    category: 'Sanat',
    time: '6 saat önce',
  },
  {
    title: 'Seyahat rotaları ve gezilecek yerlerden yeni bilgiler',
    category: 'Seyahat',
    time: '7 saat önce',
  },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Galiptekin.com.tr - Haberler, bilgi ve güncel içerikler." />
    <meta name="theme-color" content="#ffffff" />

    <title>Galiptekin.com.tr - Haberler ve Güncel İçerikler</title>
  </head>

  <body>
    <header class="site-header">
      <div class="top-line">
        <div class="container top-line-inner">
          <span>Güncel haberler ve bilgi içerikleri</span>
          <span>Galiptekin.com.tr</span>
        </div>
      </div>

      <div class="container header-main">
        <a href="/" class="logo" aria-label="Galiptekin.com.tr ana sayfa">
          Galiptekin<span>.com.tr</span>
        </a>

        <nav class="main-nav" aria-label="Ana menü">
          {categories.map((category) => (
            <a href={`#${category.toLowerCase()}`}>{category}</a>
          ))}
        </nav>
      </div>

      <div class="category-bar">
        <div class="container category-inner">
          <span class="category-title">Kategoriler</span>

          {categories.map((category) => (
            <a href={`#${category.toLowerCase()}`}>{category}</a>
          ))}
        </div>
      </div>
    </header>

    <main>
      <section class="hero-section">
        <div class="container hero-grid">
          <article class="hero-main">
            <div class="image-placeholder large">
              <span>HABER GÖRSELİ</span>
            </div>

            <div class="hero-content">
              <span class="news-category">Gündem</span>
              <h1>Galiptekin.com.tr haber sitesinin ana manşet alanı</h1>
              <p>
                Güncel gelişmeler, dünyadan haberler, ekonomi, bilim, tarih,
                sanat ve daha fazlası tek bir yerde.
              </p>
            </div>
          </article>

          <aside class="side-news">
            <article class="side-card">
              <div class="image-placeholder">
                <span>GÖRSEL</span>
              </div>
              <span class="news-category">Dünya</span>
              <h2>Dünyadan günün öne çıkan gelişmeleri</h2>
            </article>

            <article class="side-card">
              <div class="image-placeholder">
                <span>GÖRSEL</span>
              </div>
              <span class="news-category">Bilim</span>
              <h2>Bilim dünyasından yeni araştırmalar</h2>
            </article>

            <article class="side-card">
              <div class="image-placeholder">
                <span>GÖRSEL</span>
              </div>
              <span class="news-category">Ekonomi</span>
              <h2>Ekonomide öne çıkan yeni gelişmeler</h2>
            </article>
          </aside>
        </div>
      </section>

      <section class="latest-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="section-kicker">SON HABERLER</span>
              <h2>Günün öne çıkan içerikleri</h2>
            </div>

            <a href="/" class="all-link">Tüm içerikler →</a>
          </div>

          <div class="news-grid">
            {latestNews.map((news) => (
              <article class="news-card">
                <div class="image-placeholder">
                  <span>GÖRSEL</span>
                </div>

                <div class="news-card-content">
                  <span class="news-category">{news.category}</span>
                  <h3>{news.title}</h3>
                  <time>{news.time}</time>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="topics-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="section-kicker">KEŞFET</span>
              <h2>Kategoriler</h2>
            </div>
          </div>

          <div class="topic-grid">
            {categories.map((category) => (
              <a href={`#${category.toLowerCase()}`} class="topic-card">
                <strong>{category}</strong>
                <span>İçerikleri keşfet →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a href="/" class="footer-logo">Galiptekin.com.tr</a>
          <p>Haberler, bilgi ve güncel içerikler.</p>
        </div>

        <div class="footer-links">
          <a href="/">Ana Sayfa</a>
          <a href="/">Hakkımızda</a>
          <a href="/">İletişim</a>
          <a href="/">Gizlilik</a>
        </div>
      </div>

      <div class="container copyright">
        © 2026 Galiptekin.com.tr
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Arial,
      Helvetica,
      sans-serif;
    color: #111827;
    background: #ffffff;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    width: min(1220px, calc(100% - 32px));
    margin: 0 auto;
  }

  .top-line {
    border-bottom: 1px solid #eeeeee;
    background: #fafafa;
  }

  .top-line-inner {
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: #6b7280;
    font-size: 12px;
  }

  .site-header {
    background: #ffffff;
  }

  .header-main {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    color: #1a73e8;
    text-decoration: none;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
    white-space: nowrap;
  }

  .logo span {
    color: #111827;
  }

  .main-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 22px;
  }

  .main-nav a,
  .category-inner a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .main-nav a:hover,
  .category-inner a:hover,
  .all-link:hover,
  .footer-links a:hover {
    color: #1a73e8;
  }

  .category-bar {
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
  }

  .category-inner {
    min-height: 46px;
    display: flex;
    align-items: center;
    gap: 22px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .category-title {
    color: #1a73e8;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-section {
    padding: 28px 0 42px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
    gap: 24px;
  }

  .hero-main {
    overflow: hidden;
    border: 1px solid #e6e6e6;
    background: #ffffff;
  }

  .image-placeholder {
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(135deg, #edf4ff, #f7f9fc);
    color: #7b8794;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .image-placeholder.large {
    min-height: 420px;
  }

  .hero-content {
    padding: 24px 26px 28px;
  }

  .news-category,
  .section-kicker {
    color: #1a73e8;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .hero-content h1 {
    margin: 9px 0 12px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -1.5px;
  }

  .hero-content p {
    max-width: 760px;
    margin: 0;
    color: #667085;
    font-size: 17px;
    line-height: 1.65;
  }

  .side-news {
    display: grid;
    gap: 18px;
  }

  .side-card {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    grid-template-areas:
      "image category"
      "image title";
    column-gap: 15px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e6e6e6;
  }

  .side-card:last-child {
    border-bottom: 0;
  }

  .side-card .image-placeholder {
    grid-area: image;
    min-height: 120px;
  }

  .side-card .news-category {
    grid-area: category;
    align-self: end;
  }

  .side-card h2 {
    grid-area: title;
    margin: 5px 0 0;
    font-size: 19px;
    line-height: 1.3;
  }

  .latest-section,
  .topics-section {
    padding: 42px 0;
  }

  .topics-section {
    border-top: 1px solid #eeeeee;
    background: #fafafa;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 5px 0 0;
    font-size: 30px;
    letter-spacing: -0.7px;
  }

  .all-link {
    color: #1a73e8;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .news-card {
    overflow: hidden;
    border: 1px solid #e6e6e6;
    background: #fff;
  }

  .news-card .image-placeholder {
    min-height: 220px;
  }

  .news-card-content {
    padding: 18px 18px 20px;
  }

  .news-card h3 {
    margin: 7px 0 12px;
    font-size: 20px;
    line-height: 1.32;
  }

  .news-card time {
    color: #8a93a0;
    font-size: 12px;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .topic-card {
    display: flex;
    min-height: 110px;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    border: 1px solid #e2e5e9;
    background: #ffffff;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }

  .topic-card:hover {
    transform: translateY(-2px);
    border-color: #1a73e8;
  }

  .topic-card strong {
    font-size: 19px;
  }

  .topic-card span {
    color: #667085;
    font-size: 13px;
  }

  .site-footer {
    margin-top: 30px;
    border-top: 1px solid #e6e6e6;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding: 34px 0;
  }

  .footer-logo {
    color: #1a73e8;
    font-size: 21px;
    font-weight: 800;
    text-decoration: none;
  }

  .footer-inner p {
    margin: 8px 0 0;
    color: #6b7280;
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }

  .footer-links a {
    color: #4b5563;
    font-size: 14px;
    text-decoration: none;
  }

  .copyright {
    padding: 16px 0 24px;
    border-top: 1px solid #eeeeee;
    color: #8a93a0;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .header-main {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding: 18px 0;
    }

    .main-nav {
      justify-content: flex-start;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 20px, 1220px);
    }

    .top-line-inner {
      min-height: 30px;
      font-size: 10px;
    }

    .logo {
      font-size: 24px;
    }

    .main-nav {
      gap: 13px;
    }

    .main-nav a {
      font-size: 13px;
    }

    .hero-section {
      padding-top: 18px;
    }

    .image-placeholder.large {
      min-height: 240px;
    }

    .hero-content {
      padding: 20px;
    }

    .hero-content h1 {
      font-size: 31px;
    }

    .side-card {
      grid-template-columns: 110px minmax(0, 1fr);
    }

    .side-card .image-placeholder {
      min-height: 95px;
    }

    .side-card h2 {
      font-size: 16px;
    }

    .news-grid,
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>