---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroNews = {
  category: 'Dünya',
  title: 'Dünyadan öne çıkan gelişmeler',
  description: 'Günün dikkat çeken gelişmeleri ve önemli haber başlıkları.',
};

const sideNews = [
  {
    category: 'Ekonomi',
    title: 'Ekonomide günün öne çıkan gelişmeleri',
  },
  {
    category: 'Bilim',
    title: 'Bilim dünyasından yeni araştırmalar',
  },
  {
    category: 'Tarih',
    title: 'Tarihten dikkat çeken bilgiler',
  },
];

const latestNews = [
  {
    category: 'Dünya',
    title: 'Dünyadan güncel gelişmeler',
  },
  {
    category: 'Ekonomi',
    title: 'Ekonomi gündeminden önemli başlıklar',
  },
  {
    category: 'Bilim',
    title: 'Bilim ve teknoloji dünyasından haberler',
  },
  {
    category: 'Tarih',
    title: 'Geçmişten günümüze dikkat çeken olaylar',
  },
  {
    category: 'Sanat',
    title: 'Sanat ve kültür dünyasından gelişmeler',
  },
  {
    category: 'Seyahat',
    title: 'Gezilecek yerler ve seyahat rehberleri',
  },
];
---

<BaseLayout
  title="Galiptekin.com.tr - Haberler ve Güncel İçerikler"
  description="Galiptekin.com.tr haber, bilgi ve güncel içerikler."
>
  <section class="hero">
    <div class="container hero-grid">
      <article class="hero-main">
        <div class="placeholder hero-image">
          <span>HABER GÖRSELİ</span>
        </div>

        <div class="hero-content">
          <span class="category">{heroNews.category}</span>
          <h1>{heroNews.title}</h1>
          <p>{heroNews.description}</p>
        </div>
      </article>

      <aside class="side-news">
        {sideNews.map((news) => (
          <article class="side-card">
            <div class="placeholder side-image">
              <span>GÖRSEL</span>
            </div>

            <div class="side-content">
              <span class="category">{news.category}</span>
              <h2>{news.title}</h2>
            </div>
          </article>
        ))}
      </aside>
    </div>
  </section>

  <section class="latest">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-kicker">SON İÇERİKLER</span>
          <h2>Günün öne çıkanları</h2>
        </div>

        <a href="/tum-haberler/">Tüm içerikler →</a>
      </div>

      <div class="news-grid">
        {latestNews.map((news) => (
          <article class="news-card">
            <div class="placeholder card-image">
              <span>GÖRSEL</span>
            </div>

            <div class="card-content">
              <span class="category">{news.category}</span>
              <h3>{news.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 32px 0 48px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
    gap: 24px;
  }

  .hero-main,
  .side-card,
  .news-card {
    border: 1px solid var(--border);
    background: #fff;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #edf4ff, #f8fafc);
    color: #7b8794;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .hero-image {
    min-height: 430px;
  }

  .hero-content {
    padding: 24px;
  }

  .category,
  .section-kicker {
    color: var(--site-blue);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .hero-content h1 {
    margin: 8px 0 12px;
    font-size: clamp(32px, 4vw, 50px);
    line-height: 1.05;
    letter-spacing: -1.5px;
  }

  .hero-content p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }

  .side-news {
    display: grid;
    gap: 18px;
  }

  .side-card {
    display: grid;
    grid-template-columns: 135px 1fr;
    gap: 15px;
    padding: 0 0 18px;
    border-width: 0 0 1px;
  }

  .side-card:last-child {
    border-bottom: 0;
  }

  .side-image {
    min-height: 120px;
  }

  .side-content {
    padding-top: 4px;
  }

  .side-content h2 {
    margin: 7px 0 0;
    font-size: 19px;
    line-height: 1.3;
  }

  .latest {
    padding: 42px 0 56px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 5px 0 0;
    font-size: 30px;
    letter-spacing: -0.7px;
  }

  .section-heading a {
    color: var(--site-blue);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .card-image {
    min-height: 220px;
  }

  .card-content {
    padding: 18px;
  }

  .card-content h3 {
    margin: 7px 0 0;
    font-size: 20px;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .hero-image {
      min-height: 250px;
    }

    .side-card {
      grid-template-columns: 105px 1fr;
    }

    .side-image {
      min-height: 95px;
    }

    .news-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>