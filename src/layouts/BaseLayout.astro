---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Galiptekin.com.tr - Haberler, bilgi ve güncel içerikler.',
  image = '/og-image.jpg',
} = Astro.props;

const siteUrl = 'https://galiptekin.com.tr';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const absoluteImage = new URL(image, siteUrl).toString();
const isHomePage = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <title>{title}</title>

    <link
      rel="canonical"
      href={canonical}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Galiptekin.com.tr RSS"
      href={`${siteUrl}/rss.xml`}
    />

    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Galiptekin.com.tr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />

    {isHomePage ? (
      <meta property="og:type" content="website" />
    ) : (
      <meta property="og:type" content="article" />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <!-- WebSite + Organization schema -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            url: `${siteUrl}/`,
            name: 'Galiptekin.com.tr',
            description:
              'Galiptekin.com.tr - Haberler, bilgi ve güncel içerikler.',
            inLanguage: 'tr-TR',
            publisher: {
              '@id': `${siteUrl}/#organization`,
            },
          },
          {
            '@type': 'Organization',
            '@id': `${siteUrl}/#organization`,
            name: 'Galiptekin.com.tr',
            url: `${siteUrl}/`,
            logo: {
              '@type': 'ImageObject',
              url: `${siteUrl}/logo.png`,
              width: 1200,
              height: 208,
            },
          },
        ],
      })}
    </script>

    <!-- Sayfaya özel head içeriği -->
    <slot name="head" />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>